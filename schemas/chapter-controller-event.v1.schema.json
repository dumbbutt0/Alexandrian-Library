{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexandrian-library.local/schemas/chapter-controller-event.v1.schema.json",
  "title": "Alexandrian Library chapter controller event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "event_id",
    "event_type",
    "recorded_at",
    "previous_event_sha256",
    "payload",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "legacy_state_imported",
        "contract_opened",
        "contract_started",
        "provider_call_acknowledged",
        "contract_completed",
        "contract_failed",
        "contract_reconciled",
        "retry_authorized"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "previous_event_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
