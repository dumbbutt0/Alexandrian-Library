{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexandrian-library.local/schemas/synthesis-plan-audit.v1.schema.json",
  "title": "Alexandrian synthesis plan audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "book_id",
    "plan_attempt",
    "context_sha256",
    "inventory_sha256",
    "plan_draft_sha256",
    "findings",
    "overall_status",
    "blocking_reasons"
  ],
  "properties": {
    "book_id": {
      "type": "string",
      "pattern": "^book-[A-Za-z0-9._-]+$"
    },
    "plan_attempt": {
      "type": "integer",
      "enum": [1, 2]
    },
    "context_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "plan_draft_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "classification", "explanation"],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "candidate_supported",
              "human_authorized",
              "neutral_editorial",
              "preserves_unresolved",
              "unsupported"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "overall_status": {
      "type": "string",
      "enum": ["pass", "blocking"]
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
