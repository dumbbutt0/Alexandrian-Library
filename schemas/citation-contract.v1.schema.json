{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexandrian-library.local/schemas/citation-contract.v1.schema.json",
  "title": "Alexandrian Citation Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "marker_count",
    "cited_receipt_ids",
    "grounded_claim_count",
    "contradiction_callout_count"
  ],
  "properties": {
    "version": {"const": "1.0"},
    "marker_count": {"type": "integer", "minimum": 0},
    "cited_receipt_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "grounded_claim_count": {"type": "integer", "minimum": 0},
    "contradiction_callout_count": {"type": "integer", "minimum": 0}
  }
}
