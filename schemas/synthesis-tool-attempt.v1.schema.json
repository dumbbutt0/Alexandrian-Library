{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexandrian-library.local/schemas/synthesis-tool-attempt.v1.schema.json",
  "title": "Alexandrian synthesis tool attempt receipt",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "book_id",
    "cycle_id",
    "action_id",
    "stage",
    "backend",
    "input_hash",
    "chapter_id",
    "tool_name",
    "attempt_number",
    "attempt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"enum": ["reservation", "result"]},
    "book_id": {
      "type": "string",
      "pattern": "^book-[A-Za-z0-9._-]+$"
    },
    "cycle_id": {
      "type": "string",
      "pattern": "^cycle-[0-9]{3,}$"
    },
    "action_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "pattern": "^plan-shard-.+$"},
    "backend": {"enum": ["codex", "claude"]},
    "input_hash": {"$ref": "#/$defs/sha256"},
    "chapter_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "tool_name": {
      "enum": [
        "read_staged_synthesis_plan_shard_input",
        "submit_staged_synthesis_plan_shard",
        "save_staged_synthesis_edition_unit",
        "submit_staged_synthesis_audit_unit",
        "submit_staged_synthesis_global_audit"
      ]
    },
    "attempt_number": {"type": "integer", "minimum": 1, "maximum": 2},
    "raw_argument_sha256": {"$ref": "#/$defs/sha256"},
    "reservation_sha256": {"$ref": "#/$defs/sha256"},
    "outcome": {
      "enum": [
        "success",
        "correctable_validation_rejected",
        "argument_validation_rejected",
        "tool_execution_rejected",
        "tool_execution_failed"
      ]
    },
    "error_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "reserved_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1},
    "attempt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
