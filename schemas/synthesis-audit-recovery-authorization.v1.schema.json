{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexandrian-library.local/schemas/synthesis-audit-recovery-authorization.v1.schema.json",
  "title": "Alexandrian synthesis audit-recovery authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book_id",
    "cycle_id",
    "protocol_version",
    "transition_kind",
    "candidate_path",
    "candidate_sha256",
    "prior_cycle_id",
    "prior_cycle_root_path",
    "prior_cycle_authorization_path",
    "prior_cycle_authorization_sha256",
    "foundation_cycle_authorization_sha256",
    "prior_index_path",
    "prior_index_sha256",
    "prior_context_path",
    "prior_context_sha256",
    "prior_staged_index_path",
    "prior_staged_index_sha256",
    "prior_inventory_path",
    "prior_inventory_sha256",
    "prior_plan_path",
    "prior_plan_sha256",
    "prior_attempt_book_path",
    "prior_attempt_book_sha256",
    "prior_submission_path",
    "prior_submission_sha256",
    "prior_hold_path",
    "prior_hold_sha256",
    "prior_controller_path",
    "prior_controller_sha256",
    "held_stage",
    "held_unit_id",
    "resumed_attempt",
    "preserved_audit_unit_ids",
    "reused_artifacts",
    "reason",
    "human_decision_artifacts",
    "maximum_provider_calls_for_held_stage",
    "maximum_synthesis_attempts",
    "authorized_at",
    "authorization_sha256"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "book_id": {
      "type": "string",
      "pattern": "^book-[A-Za-z0-9._-]+$"
    },
    "cycle_id": {
      "type": "string",
      "pattern": "^cycle-[0-9]{3,}$"
    },
    "protocol_version": {"const": "chapter-sharded-plan-v1"},
    "transition_kind": {"const": "resume_after_audit_provider_hold"},
    "candidate_path": {"type": "string", "minLength": 1},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "prior_cycle_id": {
      "type": "string",
      "pattern": "^cycle-[0-9]{3,}$"
    },
    "prior_cycle_root_path": {"type": "string", "minLength": 1},
    "prior_cycle_authorization_path": {"type": "string", "minLength": 1},
    "prior_cycle_authorization_sha256": {"$ref": "#/$defs/sha256"},
    "foundation_cycle_authorization_sha256": {"$ref": "#/$defs/sha256"},
    "prior_index_path": {"type": "string", "minLength": 1},
    "prior_index_sha256": {"$ref": "#/$defs/sha256"},
    "prior_context_path": {"type": "string", "minLength": 1},
    "prior_context_sha256": {"$ref": "#/$defs/sha256"},
    "prior_staged_index_path": {"type": "string", "minLength": 1},
    "prior_staged_index_sha256": {"$ref": "#/$defs/sha256"},
    "prior_inventory_path": {"type": "string", "minLength": 1},
    "prior_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "prior_plan_path": {"type": "string", "minLength": 1},
    "prior_plan_sha256": {"$ref": "#/$defs/sha256"},
    "prior_attempt_book_path": {"type": "string", "minLength": 1},
    "prior_attempt_book_sha256": {"$ref": "#/$defs/sha256"},
    "prior_submission_path": {"type": "string", "minLength": 1},
    "prior_submission_sha256": {"$ref": "#/$defs/sha256"},
    "prior_hold_path": {"type": "string", "minLength": 1},
    "prior_hold_sha256": {"$ref": "#/$defs/sha256"},
    "prior_controller_path": {"type": "string", "minLength": 1},
    "prior_controller_sha256": {"$ref": "#/$defs/sha256"},
    "held_stage": {
      "type": "string",
      "pattern": "^audit-S1-[A-Za-z0-9._-]+$"
    },
    "held_unit_id": {"type": "string", "minLength": 1},
    "resumed_attempt": {"const": 1},
    "preserved_audit_unit_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "reused_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "sha256"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "reason": {"type": "string", "minLength": 1},
    "human_decision_artifacts": {"type": "array"},
    "maximum_provider_calls_for_held_stage": {"const": 2},
    "maximum_synthesis_attempts": {"const": 2},
    "authorized_at": {"type": "string", "minLength": 1},
    "authorization_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
